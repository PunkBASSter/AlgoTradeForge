{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "try-build-plugins",
            "type": "shell",
            "command": "if (Test-Path '../AlgoTradeForge.Private/src/AlgoTradeForge.Strategies.Private') { dotnet build ../AlgoTradeForge.Private/src/AlgoTradeForge.Strategies.Private } else { Write-Host 'No private plugins repo, skipping' }",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run-backend-with-log",
            "type": "shell",
            "command": "dotnet run --project src/AlgoTradeForge.WebApi *> optimization-diag.log",
            "dependsOn": "build-backend",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "build-backend",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/AlgoTradeForge.WebApi/AlgoTradeForge.WebApi.csproj",
                "-c",
                "Debug"
            ],
            "dependsOn": "try-build-plugins",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-history-loader",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/AlgoTradeForge.HistoryLoader.WebApi/AlgoTradeForge.HistoryLoader.WebApi.csproj",
                "-c",
                "Debug"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
