<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Vendored Interactive Brokers TWS API C# source (version 10.45.01).
    Compiled with IB's intended settings: nullable OFF (the source predates NRT),
    implicit usings OFF (source carries explicit usings). Do not "fix" warnings here —
    this is third-party code, re-fetched per ../README.md, not ours to maintain.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>IBApi</AssemblyName>
    <RootNamespace>IBApi</RootNamespace>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.5" />
  </ItemGroup>
</Project>
