<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- CVE-2025-6965 (GHSA-2m69-gcr7-jv3q): SQLite aggregate-terms memory corruption in the
         e_sqlite3 native lib pulled transitively by Microsoft.Data.Sqlite. Affects SQLitePCLRaw
         <= 2.1.11 with NO patched release available yet (the SQLite 3.50.2 fix is not bundled in
         any SQLitePCLRaw build). Only reachable via crafted untrusted SQL; this app runs only
         app-controlled queries against internal SQLite stores. Remove this suppression once
         SQLitePCLRaw ships a build bundling SQLite >= 3.50.2, then bump the package. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>
